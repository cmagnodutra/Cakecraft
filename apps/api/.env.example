# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# O .env real nunca e versionado (ver .gitignore na raiz).

# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3001

# Origem autorizada no CORS (frontend Next.js em desenvolvimento)
CORS_ORIGIN=http://localhost:3000

# Postgres - as credenciais abaixo batem com o docker-compose de desenvolvimento
DATABASE_URL=postgresql://cakecraft:cakecraft@localhost:5432/cakecraft?schema=public

# Redis - cache de catalogo e Pub/Sub de eventos de dominio
REDIS_URL=redis://localhost:6379
